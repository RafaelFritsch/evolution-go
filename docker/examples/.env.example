# Evolution GO - Configuração de Ambiente
# Copie este arquivo para .env e ajuste conforme necessário

# ========================================
# CONFIGURAÇÕES OBRIGATÓRIAS
# ========================================

# Porta do servidor
SERVER_PORT=4000

# Nome do cliente/instância
CLIENT_NAME=evolution

# Chave de API (OBRIGATÓRIO - Use uma chave forte e única)
GLOBAL_API_KEY=sua-chave-api-segura-aqui-uuid-recomendado

# ========================================
# BANCO DE DADOS
# ========================================

# PostgreSQL (RECOMENDADO para produção)
POSTGRES_AUTH_DB=postgresql://postgres:postgres@postgres:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:postgres@postgres:5432/evogo_users?sslmode=disable

# Pool de conexões PostgreSQL
# Use para controlar quantas conexões cada réplica abre contra o PostgreSQL.
# Útil quando há erro de conexões esgotadas, travamentos aguardando conexão ou
# banco com pouca memória. Defaults do código: 10 abertas e 2 ociosas por pool.
# Aumente somente após observar /server/db-stats e pg_stat_activity.
# Durações aceitam formato Go (30s, 5m) ou número em segundos.
POSTGRES_USERS_MAX_OPEN_CONNS=10
POSTGRES_USERS_MAX_IDLE_CONNS=2
POSTGRES_AUTH_MAX_OPEN_CONNS=10
POSTGRES_AUTH_MAX_IDLE_CONNS=2
POSTGRES_CONN_MAX_LIFETIME=5m
POSTGRES_CONN_MAX_IDLE_TIME=1m

# Timeout para operações de banco
# Cancela queries/migrations que ficarem presas esperando conexão, lock ou I/O.
# Reduza para falhar rápido em saturação; aumente apenas para queries conhecidas
# que sejam legitimamente lentas.
DB_QUERY_TIMEOUT=5s

# Salvar mensagens no banco de dados
DATABASE_SAVE_MESSAGES=false

# ========================================
# LOGS E DEBUG
# ========================================

# Nível de debug do WhatsApp (INFO, DEBUG, ERROR)
# DEBUG_ENABLED e LOG_TYPE são os nomes lidos pela aplicação. WADEBUG/LOGTYPE
# podem existir em stacks antigas; prefira estes nomes em novos deploys.
DEBUG_ENABLED=INFO

# Tipo de log (console, file)
LOG_TYPE=console

# Diretório de logs
LOG_DIRECTORY=/app/logs

# Tamanho máximo do arquivo de log em MB
LOG_MAX_SIZE=100

# Número máximo de arquivos de backup
LOG_MAX_BACKUPS=5

# Dias de retenção dos logs
LOG_MAX_AGE=30

# Comprimir logs antigos
LOG_COMPRESS=true

# ========================================
# CONEXÃO
# ========================================

# Conectar automaticamente ao iniciar
CONNECT_ON_STARTUP=false

# Limite de reconexão no startup
# Use quando CONNECT_ON_STARTUP=true e existirem muitas instâncias conectadas.
# Evita rajadas de reconexão que podem pressionar WhatsApp, CPU e PostgreSQL.
CONNECT_ON_STARTUP_MAX_CONCURRENCY=3
CONNECT_ON_STARTUP_DELAY_MS=250

# Enviar arquivos via webhook
WEBHOOK_FILES=true

# Nome do sistema operacional
OS_NAME=Linux

# ========================================
# EVENTOS E WEBHOOKS
# ========================================

# URL do webhook para receber eventos
WEBHOOK_URL=

# RabbitMQ
AMQP_URL=
AMQP_GLOBAL_ENABLED=false
AMQP_GLOBAL_EVENTS=
AMQP_SPECIFIC_EVENTS=

# NATS
NATS_URL=
NATS_GLOBAL_ENABLED=false
NATS_GLOBAL_EVENTS=

# Ignorar eventos de grupos
EVENT_IGNORE_GROUP=false

# Ignorar eventos de status
EVENT_IGNORE_STATUS=true

# ========================================
# ARMAZENAMENTO DE MÍDIA (MinIO/S3)
# ========================================

MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
MINIO_REGION=

# ========================================
# PROXY (Opcional)
# ========================================

PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ========================================
# RECURSOS ADICIONAIS
# ========================================

# API de conversão de áudio
API_AUDIO_CONVERTER=
API_AUDIO_CONVERTER_KEY=

# Número máximo de tentativas de QR Code
QRCODE_MAX_COUNT=5

# Verificar se o usuário existe antes de enviar mensagem
CHECK_USER_EXISTS=true

# Versão do WhatsApp (opcional - deixe vazio para usar a padrão)
WHATSAPP_VERSION_MAJOR=
WHATSAPP_VERSION_MINOR=
WHATSAPP_VERSION_PATCH=
